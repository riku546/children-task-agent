generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  DONE
}

enum TaskPriority {
  low
  medium
  high
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  name        String?
  image       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  groups      FamilyMember[]
  created     FamilyGroup[]  @relation("GroupCreator")
  extractions AiExtraction[]
}

model FamilyGroup {
  id          String         @id @default(cuid())
  name        String
  createdById String
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     FamilyMember[]
  invites     Invite[]
  children    Child[]
  tasks       Task[]
  extractions AiExtraction[]
}

model FamilyMember {
  id          String       @id @default(cuid())
  userId      String
  groupId     String
  role        FamilyRole   @default(MEMBER)
  displayName String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  group       FamilyGroup  @relation(fields: [groupId], references: [id])
  assigned    Task[]

  @@unique([userId, groupId])
}

model Invite {
  id        String      @id @default(cuid())
  groupId   String
  token     String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime    @default(now())
  group     FamilyGroup @relation(fields: [groupId], references: [id])
}

model Child {
  id        String      @id @default(cuid())
  groupId   String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  group     FamilyGroup @relation(fields: [groupId], references: [id])
  tasks     Task[]
}

model Task {
  id               String        @id @default(cuid())
  groupId          String
  childId          String?
  title            String
  description      String?
  type             String
  dueDate          DateTime?
  assigneeMemberId String?
  priority         TaskPriority  @default(medium)
  status           TaskStatus    @default(TODO)
  sourceText       String?
  googleEventId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  group            FamilyGroup   @relation(fields: [groupId], references: [id])
  child            Child?        @relation(fields: [childId], references: [id])
  assignee         FamilyMember? @relation(fields: [assigneeMemberId], references: [id])
}

model AiExtraction {
  id            String      @id @default(cuid())
  groupId       String
  inputType     String
  confirmedText String
  rawJson       Json
  createdById   String
  createdAt     DateTime    @default(now())
  group         FamilyGroup @relation(fields: [groupId], references: [id])
  createdBy     User        @relation(fields: [createdById], references: [id])
}
